# Optional environment overrides (copy to .env or export; never commit real values).
WOWHARNESS_CONFIG=~/.wowharness.json     # path to your copy of config.example.json
WOWHARNESS_MMAPS=                        # folder with 070.mmap + 070*.mmtile; enables the real-navmesh test
# buildgate dashboard credentials (alternative to dashboard_* keys in the config file)
BUILDGATE_DASHBOARD_URL=http://dashboard.example:8095
BUILDGATE_DASHBOARD_USER=
BUILDGATE_DASHBOARD_PASSWORD=
